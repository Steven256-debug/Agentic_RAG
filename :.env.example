GEMINI_API_KEY=your_gemini_api_key_here
DATABASE_URL=
# Required to call /ask and /documents. Keep this secret server-side; never use NEXT_PUBLIC_API_ACCESS_TOKEN.
API_ACCESS_TOKEN=generate-a-long-random-secret
# Comma-separated exact browser origins. Include your production frontend origin.
ALLOWED_ORIGINS=http://localhost:3000
# Configure the frontend API URL with HTTPS in production.
NEXT_PUBLIC_API_URL=http://localhost:8000
